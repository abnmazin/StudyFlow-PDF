rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // HELPER FUNCTIONS
    // ================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userUniversityId() {
      return getUserData().universityId;
    }

    function userRole() {
      return getUserData().role;
    }

    function userName() {
      return getUserData().username;
    }

    function isAdminOfUniversity(universityId) {
      return isAuthenticated()
        && userRole() == 'admin'
        && userUniversityId() == universityId;
    }

    function isStudentOfUniversity(universityId) {
      return isAuthenticated()
        && userRole() == 'student'
        && userUniversityId() == universityId;
    }

    function belongsToSameUniversity(universityId) {
      return isAuthenticated()
        && userUniversityId() == universityId;
    }

    // ================================================================
    // 1. USERS COLLECTION
    //    - Users read/write only their own record
    //    - Create is allowed during registration
    // ================================================================
    // ================================================================
    // 1. USERS
    //    - Read: only your own document
    //    - Self-service create: only a fresh student profile for yourself
    //    - Self-service update: only your own document, and role, isBanned,
    //      universityId and username can never change through it
    //    - Admin: may create, edit and delete any profile
    //    The old blanket "update your own document" was a privilege escalation
    //    hole. userRole() reads straight from this document, so a single
    //    update({'role': 'admin'}) unlocked every admin-only rule in the
    //    project, and update({'isBanned': false}) undid the ban. username is
    //    pinned because the login address is derived from it, so changing it
    //    would lock the account out of its own mailbox.
    // ================================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;

      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == 'student'
        && request.resource.data.isBanned == false
        && !('universityId' in request.resource.data);

      allow create: if isAuthenticated() && userRole() == 'admin';

      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.isBanned == resource.data.isBanned
        && request.resource.data.universityId == resource.data.universityId
        && request.resource.data.username == resource.data.username;

      allow update: if isAuthenticated() && userRole() == 'admin';

      allow delete: if isAuthenticated() && userRole() == 'admin';
    }

    // ================================================================
    // 2. UNIVERSITIES COLLECTION
    //    - Read: Any authenticated member of that university
    //    - Write: Only admins of that university
    //    - Delete: Only admins (with isDeleted soft-delete flag)
    // ================================================================
    match /universities/{universityId} {
      allow read: if isAuthenticated() && userUniversityId() == universityId;
      allow create: if isAuthenticated() && request.resource.data.adminUids.hasAny([request.auth.uid]);
      allow update: if isAuthenticated()
        && userUniversityId() == universityId
        && userRole() == 'admin';
      allow delete: if isAuthenticated()
        && userUniversityId() == universityId
        && userRole() == 'admin';
    }

    // ================================================================
    // 3. UNIVERSITY_FOLDERS COLLECTION
    //    - Read: Any member of the folder's university
    //    - Create: Admin of that university only
    //    - Update: Admin of that university only
    //    - Delete: Admin of that university only (soft delete preferred)
    // ================================================================
    match /university_folders/{folderId} {
      allow read: if isAuthenticated()
        && resource.data.universityId == userUniversityId();

      allow create: if isAuthenticated()
        && userRole() == 'admin'
        && request.resource.data.universityId == userUniversityId()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAuthenticated()
        && userRole() == 'admin'
        && resource.data.universityId == userUniversityId();

      allow delete: if isAuthenticated()
        && userRole() == 'admin'
        && resource.data.universityId == userUniversityId();
    }

    // ================================================================
    // 4. UNIVERSITY_FILES COLLECTION
    //    - Read: Any member of the file's university
    //    - Create: Admin of that university only
    //    - Update: Admin only (for soft delete or metadata updates)
    //    - Delete: Admin only
    // ================================================================
    match /university_files/{fileId} {
      allow read: if isAuthenticated()
        && resource.data.universityId == userUniversityId();

      allow create: if isAuthenticated()
        && userRole() == 'admin'
        && request.resource.data.universityId == userUniversityId()
        && request.resource.data.uploadedBy == request.auth.uid;

      allow update: if isAuthenticated()
        && userRole() == 'admin'
        && resource.data.universityId == userUniversityId();

      allow delete: if isAuthenticated()
        && userRole() == 'admin'
        && resource.data.universityId == userUniversityId();
    }

    // ================================================================
    // 5. UNIVERSITY VIDEOS COLLECTION (YouTube links)
    //    - Read: Any member of the video's university
    //    - Create: Admin of that university only
    //    - Update: Admin only (for soft delete or reorder)
    //    - Delete: Admin only
    // ================================================================
    match /university_videos/{videoId} {
      allow read: if isAuthenticated()
        && resource.data.universityId == userUniversityId();

      allow create: if isAuthenticated()
        && userRole() == 'admin'
        && request.resource.data.universityId == userUniversityId()
        && request.resource.data.uploadedBy == request.auth.uid;

      allow update: if isAuthenticated()
        && userRole() == 'admin'
        && resource.data.universityId == userUniversityId();

      allow delete: if isAuthenticated()
        && userRole() == 'admin'
        && resource.data.universityId == userUniversityId();
    }

    // ================================================================
    // 6. UNIVERSITY FILE MUTATIONS (existing mutation sync system)
    //    Subcollection under each university_file
    //    - Read: Any authenticated user
    //    - Write: Must belong to the file's university (admin or student)
    // ================================================================
    match /university_files/{fileId}/mutations/{mutationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && get(/databases/$(database)/documents/university_files/$(fileId)).data.universityId == userUniversityId();
    }

    // ================================================================
    // 7. UNIVERSITY_FILE_PROGRESS (reading progress sync)
    //    - Users read/write only their own progress documents
    // ================================================================
    match /university_file_progress/{progressId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow delete: if false; // Prevent accidental deletion of progress data
    }

    // ================================================================
    // 8. SYNC SESSIONS (existing — kept for backward compatibility)
    // ================================================================
    match /sync_sessions/{sessionCode} {
      allow read, write: if isAuthenticated();
    }

    // NOTE: A rule on a document does not cover its subcollections, so every
    // subcollection written by SyncService needs its own match block.

    // ================================================================
    // 9. SYNC SESSION ANNOTATIONS
    //    - Highlights, comments and page state for one file in a session
    //    - Written by every participant, so mirrors the parent session rule
    // ================================================================
    match /sync_sessions/{sessionCode}/annotations/{fileHash} {
      allow read, write: if isAuthenticated();
    }

    // ================================================================
    // 10. SYNC SESSION TRASH
    //     - Soft-deleted annotation items awaiting purge
    // ================================================================
    match /sync_sessions/{sessionCode}/trash/{itemId} {
      allow read, write: if isAuthenticated();
    }

    // ================================================================
    // 11. PDF MUTATIONS (structural sync: add/delete/reorder pages)
    //     - Top-level pdfs/{fileHash}/mutations, keyed by content hash so the
    //       same file content shares mutations across sessions
    // ================================================================
    match /pdfs/{fileHash}/mutations/{mutationId} {
      allow read, write: if isAuthenticated();
    }

    // ================================================================
    // 12. LIBRARY FILE SESSIONS
    //     - Per-file download tracking for the university library owner
    //     - Scoped to the university so only its members can read the feed
    // ================================================================
    match /library_file_sessions/{code} {
      allow read: if isAuthenticated()
        && resource.data.universityId == userUniversityId();

      allow create: if isAuthenticated()
        && request.resource.data.universityId == userUniversityId();

      // recordDownload merges downloads/lastDownloadAt onto the existing doc,
      // which Firestore evaluates as an update against the stored fields.
      allow update: if isAuthenticated()
        && resource.data.universityId == userUniversityId();

      allow delete: if false;
    }

    // ================================================================
    // 13. APP CONFIG
    //     - Read-only remote configuration (version gates, feature flags)
    //     - Written by admins only
    // ================================================================
    match /app_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && userRole() == 'admin';
    }

    // ================================================================
    // 14. MASTER SESSIONS
    //     - Study bundles distributed to students by an 8 character code
    //     - A participant fetches one bundle by code, so a direct get is open
    //       to any signed-in user who has not been banned from that bundle
    //     - Enumerating bundles is owner/admin territory: the developer
    //       dashboard lists all of them
    // ================================================================
    match /master_sessions/{code} {
      allow get: if isAuthenticated()
        && !('bannedUsernames' in resource.data
            && userName() in resource.data.bannedUsernames);

      // A non-admin may list only bundles they own. Firestore can prove that
      // for a query constrained on ownerName, which is exactly the shape
      // watchMasterBundlesByOwner sends, so the "my bundles" list works for a
      // student while enumerating everybody else's stays refused. Admin keeps
      // the unconstrained list.
      allow list: if isAuthenticated()
        && (userRole() == 'admin' || resource.data.ownerName == userName());

      allow create: if isAuthenticated()
        && request.resource.data.ownerName == userName();

      allow update: if isAuthenticated()
        && resource.data.ownerName == userName();

      allow delete: if isAuthenticated()
        && resource.data.ownerName == userName();
    }

    // ================================================================
    // 15. BLACKLISTED DEVICES
    //     - secureLogin reads its own fingerprint here right after signing
    //       in, so a bare get has to be open to any signed-in user
    //     - Enumerating the list is admin territory
    //     - Writes are admin-only on purpose: _executeImmediateBan runs in
    //       the client and is therefore not trustworthy. With this rule a
    //       banned student cannot lift their own ban, and the client side
    //       ban write simply fails for non-admins while the login itself is
    //       still refused.
    // ================================================================
    match /blacklisted_devices/{fingerprint} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && userRole() == 'admin';
      allow create, update: if isAuthenticated() && userRole() == 'admin';
      allow delete: if false;
    }

    // ================================================================
    // 16. SECURITY EVENTS
    //     - Append-only audit trail for bans and device mismatches
    //     - Clients may append, only admins may read, nobody may rewrite
    // ================================================================
    match /security_events/{eventId} {
      allow create: if isAuthenticated();
      allow read, list: if isAuthenticated() && userRole() == 'admin';
      allow update, delete: if false;
    }

    // ================================================================
    // 17. ANNOUNCEMENTS
    //     - Global notices, readable by every signed-in user
    //     - Only admins publish or edit them
    // ================================================================
    match /announcements/{announcementId} {
      allow read, list: if isAuthenticated();
      allow create, update: if isAuthenticated() && userRole() == 'admin';
      allow delete: if false;
    }
  }
}