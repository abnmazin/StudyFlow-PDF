Windows Registry Editor Version 5.00

; =========================================================================
; StudyFlow PDF File Association Registry Script
; =========================================================================
; This script registers StudyFlow as the default PDF viewer on Windows.
; 
; IMPORTANT: Before running this script:
; 1. Build your Flutter app in release mode: flutter build windows --release
; 2. Find the executable at: build\windows\runner\Release\pdfreader.exe
; 3. Update the path below to match your executable location
; 4. Right-click this file and select "Merge" to apply changes
; =========================================================================

; Create custom file type identifier
[HKEY_CLASSES_ROOT\StudyFlow.PDF]
@="PDF Document"
"FriendlyTypeName"="PDF Document (StudyFlow)"

; Set default icon (uses the PDF icon from your exe)
[HKEY_CLASSES_ROOT\StudyFlow.PDF\DefaultIcon]
@="\"D:\\Programing\\flutter\\pdfreader\\build\\windows\\runner\\Release\\pdfreader.exe\",0"

; Register shell open command
[HKEY_CLASSES_ROOT\StudyFlow.PDF\shell]
@="open"

[HKEY_CLASSES_ROOT\StudyFlow.PDF\shell\open]
@="Open with StudyFlow"

[HKEY_CLASSES_ROOT\StudyFlow.PDF\shell\open\command]
@="\"D:\\Programing\\flutter\\pdfreader\\build\\windows\\runner\\Release\\pdfreader.exe\" \"%1\""

; Associate .pdf extension with StudyFlow.PDF
[HKEY_CLASSES_ROOT\.pdf]
@="StudyFlow.PDF"

; Add to "Open With" menu
[HKEY_CLASSES_ROOT\.pdf\OpenWithProgids]
"StudyFlow.PDF"=""

; =========================================================================
; ALTERNATIVE: Set as default PDF viewer (optional)
; Uncomment the lines below if you want to force StudyFlow as the default
; =========================================================================
; [HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\FileExts\.pdf\UserChoice]
; "ProgId"="StudyFlow.PDF"
; "Hash"="GENERATED_HASH"
; Note: The Hash value is automatically generated by Windows and cannot be
; manually set. Use the "Default Programs" control panel instead.

; =========================================================================
; INSTRUCTIONS TO CUSTOMIZE:
; =========================================================================
; 1. Replace ALL instances of "C:\\Path\\To\\Your\\pdfreader.exe" with your
;    actual executable path. Use double backslashes (\\) for paths.
; 
;    Example: "C:\\Users\\YourName\\Documents\\StudyFlow\\build\\windows\\runner\\Release\\pdfreader.exe"
;
; 2. Save this file as "register_studyflow.reg"
;
; 3. Right-click the file and select "Merge" or double-click it
;
; 4. Confirm the UAC prompt
;
; 5. Double-click any PDF file - it should now open in StudyFlow!
;
; TO UNREGISTER:
; Create another .reg file with the following content to remove associations:
;
; Windows Registry Editor Version 5.00
; [-HKEY_CLASSES_ROOT\StudyFlow.PDF]
; [HKEY_CLASSES_ROOT\.pdf]
; @="AcroExch.Document" 
; =========================================================================
